{
  "name": "dps-store-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "DPS Store Windows desktop app (Electron)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron .",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "release": "pnpm build && electron-builder --publish always",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "iconv-lite": "^0.7.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
